# ===== Supabase (Auth + Database) =====
# 从 https://supabase.com/dashboard 创建项目后获取
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# 服务端专用（只放服务端代码，绝不放客户端！）
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ===== APIMODELS (AI Image API) =====
# 从 https://apimodels.app/zh/console/api-keys 创建
APIMODELS_API_KEY=sk_YOUR-APIMODELS-KEY
APIMODELS_BASE_URL=https://api.apimodels.app/v1

# ===== Stripe (Payments) =====
# 从 https://dashboard.stripe.com/apikeys 获取（测试模式用 sk_test_ 开头）
STRIPE_SECRET_KEY=sk_test_YOUR-STRIPE-KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR-WEBHOOK-SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR-PUBLISHABLE-KEY

# ===== Site =====
NEXT_PUBLIC_SITE_URL=http://localhost:3456
